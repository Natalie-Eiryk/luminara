{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminara.natalie-eiryk.com/schemas/teaching-module-v2/manifest.json",
  "title": "TeachingModuleManifest",
  "type": "object",
  "required": ["id", "title", "version", "route", "deweyPath", "audience", "sourceRefs", "itemCollections", "diagnostics", "lumiSync"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "route": { "type": "string" },
    "deweyPath": { "type": "string" },
    "audience": { "type": "string" },
    "sourceRefs": { "type": "array", "items": { "type": "string" } },
    "itemCollections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "count"],
        "properties": {
          "kind": { "type": "string" },
          "count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "diagnostics": { "type": "object" },
    "lumiSync": { "type": "object" }
  }
}
